{
  "name": "@solidjs/start",
  "version": "2.0.0-rc.6",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/solidjs/solid-start.git",
    "directory": "packages/start"
  },
  "files": [
    "dist",
    "env.d.ts",
    "CHANGELOG.md"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.tsx",
    "./config": "./dist/config/index.js",
    "./server": "./src/server/index.tsx",
    "./client": "./src/client/index.tsx",
    "./router": "./src/router.tsx",
    "./server/spa": "./src/server/spa/index.tsx",
    "./client/spa": "./src/client/spa/index.tsx",
    "./middleware": "./src/middleware/index.ts",
    "./http": "./src/http/index.ts",
    "./env": "./env.d.ts",
    "./fns/server": "./src/fns/server.ts",
    "./fns/client": "./src/fns/client.ts",
    "./serialization": "./src/fns/plugins.ts"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.jsx",
      "./config": "./dist/config/index.js",
      "./server": "./dist/server/index.jsx",
      "./client": "./dist/client/index.jsx",
      "./router": "./dist/router.jsx",
      "./server/spa": "./dist/server/spa/index.jsx",
      "./client/spa": "./dist/client/spa/index.jsx",
      "./middleware": "./dist/middleware/index.js",
      "./http": "./dist/http/index.js",
      "./env": "./env.d.ts",
      "./fns/server": "./dist/fns/server.js",
      "./fns/client": "./dist/fns/client.js",
      "./serialization": "./dist/fns/plugins.js"
    },
    "access": "public"
  },
  "scripts": {
    "build": "pnpm validate-imports && tsc && node scripts/build.js",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:ci": "vitest run",
    "typecheck": "tsc --noEmit",
    "typecheck:dist": "pnpm build && pnpx @arethetypeswrong/cli --pack . --profile esm-only",
    "validate-imports": "node scripts/validate-imports.js"
  },
  "dependencies": {
    "@solidjs/router": "2.0.0-next.12",
    "@solidjs/web": "2.0.0-beta.28",
    "cookie-es": "^3.1.1",
    "defu": "^6.1.7",
    "error-stack-parser": "^2.1.4",
    "fast-glob": "^3.3.3",
    "filesystem-routing": "0.1.1",
    "h3": "^2.0.1-rc.26",
    "html-to-image": "^1.11.13",
    "pathe": "^2.0.3",
    "radix3": "^1.1.2",
    "seroval": "^1.5.6",
    "seroval-plugins": "^1.5.6",
    "shiki": "^4.3.1",
    "solid-js": "2.0.0-beta.28",
    "source-map-js": "^1.2.1",
    "srvx": "^0.12.4",
    "terracotta": "2.0.0-next.6",
    "vite-plugin-solid": "3.0.0-next.20"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "vite": "^8 || ^9"
  },
  "engines": {
    "node": ">=24"
  }
}
